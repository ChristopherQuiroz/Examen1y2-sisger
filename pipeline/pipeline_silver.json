{
	"name": "pipeline_silver",
	"properties": {
		"activities": [
			{
				"name": "AuditarBronzeYLimpiarSilver",
				"description": "Audita bronze y vacia silver.* respetando las FK antes de recargar.",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "sql_dw_hospital",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "-- Auditoria de calidad de bronze (visible en la salida de la actividad).\n-- Los residuos que aqui aparezcan son filas que silver filtrara por diseño.\nSELECT 'patients' AS Tabla, COUNT(*) AS Filas, SUM(CASE WHEN NULLIF(LTRIM(RTRIM(patient_id)), '') IS NULL THEN 1 ELSE 0 END) AS SinId FROM bronze.patients\nUNION ALL\nSELECT 'admissions', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(admission_id)), '') IS NULL OR NULLIF(LTRIM(RTRIM(patient_id)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.admissions\nUNION ALL\nSELECT 'diagnoses', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(diagnosis_id)), '') IS NULL OR NULLIF(LTRIM(RTRIM(admission_id)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.diagnoses\nUNION ALL\nSELECT 'billing', COUNT(*), SUM(CASE WHEN NULLIF(LTRIM(RTRIM(billing_id)), '') IS NULL OR NULLIF(LTRIM(RTRIM(admission_id)), '') IS NULL THEN 1 ELSE 0 END) FROM bronze.billing;"
						},
						{
							"type": "Query",
							"text": "-- Limpieza de silver en orden de dependencias (hijos primero) para recarga idempotente.\nDELETE FROM silver.billing;\nDELETE FROM silver.diagnoses;\nDELETE FROM silver.admissions;\nDELETE FROM silver.patients;"
						}
					]
				}
			},
			{
				"name": "SL_01_Patients",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
