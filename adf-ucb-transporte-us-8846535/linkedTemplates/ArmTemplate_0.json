						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          admission_id_bk as integer,",
						"          patient_id_bk as integer,",
						"          nombre_departamento as string,",
						"          codigo_icd as string,",
						"          nivel_severidad as string,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    a.admission_id                                              AS admission_id_bk,\\n    p.paciente_key                                              AS paciente_key,\\n    dep.departamento_key                                        AS departamento_key,\\n    dg.diagnostico_key                                          AS diagnostico_key,\\n    CAST(CONVERT(CHAR(8), a.admission_date, 112) AS INT)        AS fecha_ingreso_key,\\n    CAST(CONVERT(CHAR(8), a.discharge_date, 112) AS INT)        AS fecha_alta_key,\\n    a.attending_doctor_id                                       AS medico_id,\\n    DATEDIFF(DAY, a.admission_date, a.discharge_date)           AS dias_estancia,\\n    1                                                           AS conteo_admisiones\\nFROM silver.admissions a\\nJOIN gold.dim_paciente p\\n    ON p.patient_id_bk = a.patient_id\\nJOIN gold.dim_departamento dep\\n    ON dep.nombre_departamento = a.department\\nLEFT JOIN (\\n    SELECT d.admission_id,\\n           d.icd_code,\\n           COALESCE(d.severity, \\'Desconocido\\') AS severity,\\n           ROW_NUMBER() OVER (PARTITION BY d.admission_id ORDER BY d.diagnosis_id) AS rn\\n    FROM silver.diagnoses d\\n) dp\\n    ON dp.admission_id = a.admission_id AND dp.rn = 1\\nJOIN gold.dim_diagnostico dg\\n    ON dg.codigo_icd = COALESCE(dp.icd_code, \\'N/A\\')\\n   AND dg.nivel_severidad = COALESCE(dp.severity, \\'Desconocido\\')',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admision_key as long,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
