{
	"name": "df_silver_diagnoses",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_diagnoses",
						"type": "DatasetReference"
					},
					"name": "bronce"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "admisiones"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_diagnoses_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "limpiar"
				},
				{
					"name": "normalizarIcd"
				},
				{
					"name": "validos"
				},
				{
					"name": "deduplicar"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> bronce",
				"source(output(",
				"          admission_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> admisiones",
				"bronce derive(diagnosis_id = iif(!isNull(diagnosis_id) && regexMatch(trim(diagnosis_id), '^\\\\d+$'), toInteger(trim(diagnosis_id)), toInteger(null())),",
				"          admission_id = iif(!isNull(admission_id) && regexMatch(trim(admission_id), '^\\\\d+$'), toInteger(trim(admission_id)), toInteger(null())),",
				"          icd_code = upper(replace(replace(trim(split(icd_code, ',')[1]), '-', '.'), ' ', '')),",
				"          diagnosis_description = iif(isNull(diagnosis_description) || trim(diagnosis_description) == '', toString(null()), trim(diagnosis_description)),",
				"          severity = iif(\r",
				"    isNull(severity), \r",
				"    toString(null()), \r",
				"    iif(\r",
				"        regexMatch(lower(trim(severity)), '^(mild|moderate|severe|critical)$'), \r",
				"        initCap(lower(trim(severity))), \r",
				"        toString(null())\r",
				"    )\r",
				")) ~> limpiar",
				"limpiar derive(icd_code = iif(!isNull(icd_code) && instr(icd_code, '.') == 0 && length(icd_code) > 3, concat(left(icd_code, 3), '.', substring(icd_code, 4, length(icd_code))), icd_code)) ~> normalizarIcd",
				"normalizarIcd filter(!isNull(diagnosis_id)",
				"&& !isNull(admission_id)",
				"&& !isNull(icd_code)",
				"&& regexMatch(icd_code, '^[A-Z]\\\\d{2}(\\\\.[A-Z0-9]{1,4})?$')) ~> validos",
				"union1 aggregate(groupBy(diagnosis_id),",
				"     admission_id = first(admission_id),",
				"          icd_code = first(icd_code),",
				"          diagnosis_description = first(diagnosis_description),",
				"          severity = first(severity)) ~> deduplicar",
				"validos, admisiones union(byName: true)~> union1",
				"deduplicar sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          diagnosis_id,",
				"          admission_id,",
				"          icd_code,",
				"          diagnosis_description,",
				"          severity",
				"     )) ~> sink1"
			]
		}
	}
}